{
  "name": "@inhuman.tools/scope-plane-electric",
  "version": "0.4.0",
  "description": "PostgreSQL ElectricSQL ShapeSource and RowPlane bindings for @inhuman.tools/scope-plane.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "!**/__tests__", "README.md", "LICENSE.md"],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "tsc -p tsconfig.json --noEmit && vitest run",
    "test:postgres": "SCOPE_PLANE_POSTGRES_TEST=1 vitest run src/__tests__/postgres.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@electric-sql/client": "1.5.28",
    "@inhuman.tools/harness-contract": "workspace:^",
    "@inhuman.tools/scope-plane": "workspace:^"
  },
  "devDependencies": {
    "@-internal-/eslint-configs": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/inhuman-harness.git",
    "directory": "packages/scope-plane-electric"
  },
  "browserslist": ["node >= 22"]
}
