{
  "name": "@inhuman.tools/plexus-expectations",
  "version": "0.0.0",
  "private": true,
  "description": "Work graph: WorkExpectation (PEW), Job + honoring executor.",
  "license": "MIT",
  "author": "here.build",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./executor": {
      "types": "./dist/executor/index.d.ts",
      "import": "./dist/executor/index.js",
      "default": "./dist/executor/index.js"
    },
    "./driver": {
      "types": "./dist/driver/index.d.ts",
      "import": "./dist/driver/index.js",
      "default": "./dist/driver/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!**/__tests__",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@here.build/collections": "0.9.0",
    "@inhuman.tools/error-with-invariant": "workspace:^",
    "tiny-invariant": "^1.3.3",
    "zod": "^4.4.3",
    "tslib": "2.8.1",
    "xstate": "5.32.5"
  },
  "devDependencies": {
    "@-internal-/eslint-configs": "workspace:*",
    "@-internal-/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "9.39.2",
    "prettier": "3.8.1",
    "typescript": "6.0.2",
    "vitest": "4.1.0",
    "yjs": "13.6.33",
    "mobx": "6.16.1",
    "@here.build/plexus": "^0.9.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/inhuman-harness.git",
    "directory": "packages/plexus-expectations"
  },
  "peerDependencies": {
    "mobx": "6.16.1",
    "@here.build/plexus": "^0.9.6"
  }
}
