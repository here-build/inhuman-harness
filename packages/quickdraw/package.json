{
  "name": "@inhuman.tools/quickdraw",
  "version": "0.2.0",
  "description": "Terminal paint substrate: startRender host + TEA widgets.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./input": {
      "types": "./dist/input/index.d.ts",
      "import": "./dist/input/index.js",
      "default": "./dist/input/index.js"
    },
    "./measure": {
      "types": "./dist/measure/index.d.ts",
      "import": "./dist/measure/index.js",
      "default": "./dist/measure/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./widgets": {
      "types": "./dist/widgets/index.d.ts",
      "import": "./dist/widgets/index.js",
      "default": "./dist/widgets/index.js"
    },
    "./widgets/*": {
      "types": "./dist/widgets/*.d.ts",
      "import": "./dist/widgets/*.js",
      "default": "./dist/widgets/*.js"
    },
    "./buffer": {
      "types": "./dist/buffer/index.d.ts",
      "import": "./dist/buffer/index.js",
      "default": "./dist/buffer/index.js"
    },
    "./lexicon": {
      "types": "./dist/lexicon/index.d.ts",
      "import": "./dist/lexicon/index.js",
      "default": "./dist/lexicon/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js",
      "default": "./dist/layout/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js",
      "default": "./dist/theme/index.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "import": "./dist/capabilities/index.js",
      "default": "./dist/capabilities/index.js"
    },
    "./internals/bgfx": {
      "types": "./dist/internals/bgfx/index.d.ts",
      "import": "./dist/internals/bgfx/index.js",
      "default": "./dist/internals/bgfx/index.js"
    },
    "./internals/bgfx-worker": {
      "types": "./dist/internals/bgfx-worker.d.ts",
      "import": "./dist/internals/bgfx-worker.js",
      "default": "./dist/internals/bgfx-worker.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project logic --project storybook",
    "test:visual": "vitest run --project visual",
    "storybook": "tsx src/storybook/main.ts",
    "fx": "tsx src/storybook/fx-demo.ts",
    "visual": "vitest run --config vitest.visual.config.ts",
    "bench": "tsc -p tsconfig.build.json && node dist/bench/main.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "culori": "^4.0.2",
    "diff": "^7.0.0",
    "shiki": "^3.0.0",
    "streaming-markdown": "^0.2.15",
    "string-width": "^8.0.0",
    "tiny-invariant": "^1.3.3"
  },
  "optionalDependencies": {
    "gl": "8.1.6"
  },
  "devDependencies": {
    "@-internal-/eslint-configs": "workspace:*",
    "@types/culori": "^4.0.1",
    "@types/diff": "7.0.2",
    "@types/node": "^24.0.0",
    "eslint": "9.39.2",
    "tsx": "^4.19.4",
    "typescript": "6.0.2",
    "vitest": "4.1.0",
    "mobx": "6.16.1"
  },
  "license": "MIT",
  "author": "Merkle Bonsai",
  "homepage": "https://github.com/here-build/inhuman-harness#readme",
  "bugs": {
    "url": "https://github.com/here-build/inhuman-harness/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/here-build/inhuman-harness.git",
    "directory": "packages/quickdraw"
  },
  "keywords": [
    "terminal",
    "tui",
    "quickdraw"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "fonts",
    "*.vert",
    "LICENSE.md",
    "README.md",
    "!**/__tests__",
    "!**/__test__",
    "!**/__visual__",
    "!**/*.test.*"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "mobx": "6.16.1"
  },
  "browserslist": [
    "node >= 22"
  ],
  "engines": {
    "node": ">=22"
  }
}
