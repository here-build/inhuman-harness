    "tiny-invariant": "^1.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@-internal-/eslint-configs": "workspace:*",
    "@types/node": "^24.0.0",
    "dedent": "1.7.2",
    "eslint": "9.39.2",
    "mobx": "6.16.1",
    "typescript": "6.0.2",
    "vitest": "4.1.0"
  },
