{
  "name": "@inhuman.tools/tool-call-normalize",
  "version": "0.1.0",
  "description": "Model-native tool dialects → OpenAI tool_calls + clean prose. Normalizes streamed and batch LLM output (Hermes, LongCat, Qwen XML, OpenAI-native, …) into one IR.",
  "keywords": [
    "llm",
    "tool-calling",
    "streaming",
    "normalize"
  ],
  "license": "MIT",
  "author": "Merkle Bonsai",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inhuman.tools/error-with-invariant": "workspace:^",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@-internal-/eslint-configs": "workspace:*",
    "@-internal-/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "dedent": "^1.7.2",
    "eslint": "9.39.2",
    "tslib": "2.8.1",
    "typescript": "6.0.2",
    "vitest": "4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/here-build/inhuman-harness.git",
    "directory": "packages/tool-call-normalize"
  },
  "browserslist": [
    "last 2 chrome versions",
    "last 2 firefox versions",
    "last 2 safari versions",
    "ios_saf >= 16.4",
    "node >= 22"
  ],
  "publishConfig": {
    "access": "public"
  }
}
