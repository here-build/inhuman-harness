{
  "name": "@inhuman.tools/harness-model",
  "version": "0.1.0",
  "description": "Harness document models, Plexus wrappers, and model schemas. No client transport.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "import": "./dist/kernel/index.js",
      "default": "./dist/kernel/index.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "import": "./dist/session/index.js",
      "default": "./dist/session/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js",
      "default": "./dist/register.js"
    },
    "./json-record": {
      "types": "./dist/json-record.d.ts",
      "import": "./dist/json-record.js",
      "default": "./dist/json-record.js"
    },
    "./vt-text": {
      "types": "./dist/vt-text.d.ts",
      "import": "./dist/vt-text.js",
      "default": "./dist/vt-text.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js",
      "default": "./dist/schemas/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js",
      "default": "./dist/shared/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "dependencies": {
    "@here.build/arrival": "^0.10.2",
    "@inhuman.tools/activity": "workspace:^",
    "@inhuman.tools/continuation": "workspace:^",
    "@inhuman.tools/harness-commons": "workspace:^",
    "@inhuman.tools/plexus-expectations": "workspace:^",
    "@inhuman.tools/statusline": "workspace:^",
    "nanoid": "5.1.5",
    "tiny-invariant": "^1.3.3",
    "type-fest": "5.4.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@-internal-/eslint-configs": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "9.39.2",
    "typescript": "6.0.2",
    "vitest": "4.1.0",
    "yjs": "13.6.33",
    "mobx": "6.16.1",
    "@here.build/plexus": "^0.9.6"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/here-build/inhuman-harness.git",
    "directory": "packages/harness-model"
  },
  "peerDependencies": {
    "yjs": "13.6.33",
    "mobx": "6.16.1",
    "@here.build/plexus": "^0.9.6"
  },
  "browserslist": [
    "last 2 chrome versions",
    "last 2 firefox versions",
    "last 2 safari versions",
    "ios_saf >= 16.4",
    "node >= 22"
  ],
  "author": "Merkle Bonsai",
  "publishConfig": {
    "access": "public"
  }
}
