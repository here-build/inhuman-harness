{
  "name": "@inhuman.tools/harness-cli",
  "version": "0.1.0",
  "description": "The `harness` command: TUI attach, web, eval, daemon, mcp, install and completion over the daemon. The TUI and the web app load on demand from their own packages.",
  "type": "module",
  "bin": {
    "harness": "./bin/harness.mjs"
  },
  "exports": {
    "./run": {
      "types": "./dist/bin.d.ts",
      "import": "./dist/bin.js",
      "default": "./dist/bin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist"
  ],
  "browserslist": [
    "node >= 22"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && env DEBUG='*' node dist/bin.js --restart-daemon",
    "dev:no-restart": "tsc -p tsconfig.build.json && env DEBUG='*' node dist/bin.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit && vitest run --project logic",
    "test:process": "vitest run --project process"
  },
  "dependencies": {
    "@here.build/arrival-serializer": "^0.10.2",
    "@inhuman.tools/harness": "workspace:^",
    "@inhuman.tools/harness-contract": "workspace:^",
    "@inhuman.tools/harness-diagnostics": "workspace:^",
    "@inhuman.tools/harness-model": "workspace:^",
    "@inhuman.tools/harness-sdk": "workspace:^",
    "clipanion": "4.0.0-rc.4",
    "mobx": "6.16.1",
    "typanion": "3.14.0"
  },
  "peerDependencies": {
    "@inhuman.tools/harness-tui": "workspace:^",
    "@inhuman.tools/harness-web-app": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@inhuman.tools/harness-tui": {
      "optional": true
    },
    "@inhuman.tools/harness-web-app": {
      "optional": true
    }
  },
  "devDependencies": {
    "@-internal-/eslint-configs": "workspace:*",
    "@here.build/arrival": "^0.10.2",
    "@here.build/plexus": "^0.9.6",
    "@inhuman.tools/harness-commons": "workspace:^",
    "@inhuman.tools/harness-peer": "workspace:^",
    "@inhuman.tools/harness-tui": "workspace:^",
    "@inhuman.tools/harness-web-app": "workspace:^",
    "@inhuman.tools/plexus-expectations": "workspace:^",
    "@types/node": "^24.0.0",
    "eslint": "9.39.2",
    "typescript": "6.0.2",
    "vitest": "4.1.0",
    "y-websocket": "3.1.0",
    "yjs": "13.6.33"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/here-build/inhuman-harness.git",
    "directory": "packages/harness-cli"
  },
  "author": "Merkle Bonsai",
  "publishConfig": {
    "access": "public"
  }
}
