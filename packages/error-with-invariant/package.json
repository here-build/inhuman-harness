{
  "name": "@inhuman.tools/error-with-invariant",
  "version": "0.2.0",
  "description": "Error base whose static invariant throws new this(...ctorArgs).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@-internal-/eslint-configs": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "9.39.2",
    "typescript": "6.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/here-build/inhuman-harness.git",
    "directory": "packages/error-with-invariant"
  },
  "browserslist": [
    "last 2 chrome versions",
    "last 2 firefox versions",
    "last 2 safari versions",
    "ios_saf >= 16.4",
    "node >= 22"
  ],
  "author": "Merkle Bonsai",
  "publishConfig": {
    "access": "public"
  }
}
