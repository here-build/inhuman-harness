{
  "name": "@inhuman.tools/harness-client",
  "version": "0.2.0",
  "description": "Transport-agnostic typed client for the harness daemon, built on the harness-contract.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "sideEffects": false,
  "browserslist": [
    "last 2 chrome versions",
    "last 2 firefox versions",
    "last 2 safari versions",
    "ios_saf >= 16.4",
    "node >= 22"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "dependencies": {
    "@inhuman.tools/harness-contract": "workspace:^",
    "@orpc/client": "1.15.7",
    "@orpc/contract": "1.15.7"
  },
  "peerDependencies": {
    "ws": "^8.18.3"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@-internal-/eslint-configs": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/ws": "8.18.1",
    "eslint": "9.39.2",
    "typescript": "6.0.2",
    "vitest": "4.1.0",
    "ws": "8.18.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/here-build/inhuman-harness.git",
    "directory": "packages/harness-client"
  },
  "author": "Merkle Bonsai",
  "publishConfig": {
    "access": "public"
  }
}
