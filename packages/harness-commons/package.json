{
  "name": "@inhuman.tools/harness-commons",
  "version": "0.0.1",
  "private": true,
  "description": "Shared prompt brands and the disposed-entity guard. Sole home of prompt and DisposableClass.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "dependencies": {
    "dedent": "1.7.2",
    "type-fest": "5.4.4"
  },
  "devDependencies": {
    "@-internal-/eslint-configs": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "9.39.2",
    "typescript": "6.0.2",
    "vitest": "4.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/inhuman-harness.git",
    "directory": "packages/harness-commons"
  }
}
