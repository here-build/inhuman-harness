{
  "name": "@inhuman.tools/statusline-opencode",
  "version": "0.0.1",
  "private": true,
  "description": "OpenCode TUI plugin: the git statusline clause (no branch) under the prompt.",
  "type": "module",
  "exports": {
    "./tui": "./src/tui.tsx",
    "./refresher": {
      "types": "./dist/refresher.d.ts",
      "import": "./dist/refresher.js",
      "default": "./dist/refresher.js"
    },
    "./package.json": "./package.json"
  },
  "browserslist": [
    "node >= 22"
  ],
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "tsc -p tsconfig.json --noEmit && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inhuman.tools/statusline": "workspace:^"
  },
  "devDependencies": {
    "@-internal-/eslint-configs": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "9.39.2",
    "typescript": "6.0.2",
    "vitest": "4.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/inhuman-harness.git",
    "directory": "packages-statusline/opencode-statusline"
  }
}
