{
  "name": "@inhuman.tools/harness-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Agent harness product — process entities + quickdraw paint substrate. Dual-mode: standalone or fused into here.build monorepo.",
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "test:process": "pnpm --filter @inhuman.tools/harness-cli test:process && pnpm --filter @inhuman.tools/harness test:process",
    "test:visual": "pnpm --filter @inhuman.tools/harness-tui test:visual",
    "test:boundaries": "node --test scripts/packed-product.test.mjs",
    "verify": "pnpm test:boundaries && pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm test:process && pnpm test:visual",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "test:umbrella": "pnpm --filter @inhuman.tools/quickdraw test",
    "pretty-mcp:retrieve": "pnpm --filter @inhuman.tools/pretty-mcp retrieve",
    "pretty-mcp:generate": "pnpm --filter @inhuman.tools/pretty-mcp generate",
    "pretty-mcp:uncovered": "pnpm --filter @inhuman.tools/pretty-mcp uncovered",
    "check:color-parity": "node packages/quickdraw/scripts/check-color-parity.mjs",
    "check:color-parity:update": "node packages/quickdraw/scripts/check-color-parity.mjs --update",
    "qd:prebuild": "node scripts/qd-prebuild.mjs"
  },
  "devDependencies": {
    "turbo": "2.5.6",
    "typescript": "6.0.2",
    "vitest": "4.1.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@here.build/arrival-syntax": "^0.10.0",
      "mobx": "6.16.1",
      "zod": "^4.4.3"
    },
    "patchedDependencies": {
      "@here.build/arrival-provenance@0.10.0": "patches/@here.build__arrival-provenance@0.10.0.patch",
      "react-native-screens@4.30.0": "patches/react-native-screens@4.30.0.patch"
    }
  },
  "license": "MIT"
}
