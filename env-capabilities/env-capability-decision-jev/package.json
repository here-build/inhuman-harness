{
  "name": "@inhuman.tools/env-capability-decision-jev",
  "version": "0.0.1",
  "private": true,
  "description": "Arrival decide/yesno and decide/choose via a Jev client class on the capability resources.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "!**/__tests__"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
