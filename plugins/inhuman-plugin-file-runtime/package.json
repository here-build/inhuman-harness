{
  "name": "@inhuman.tools/plugin-file-runtime",
  "version": "0.0.1",
  "private": true,
  "description": "Transcript file environments and isolated code execution through Microsandbox.",
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "runtime", "examples", "README.md", "LICENSE.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:microvm": "FILE_RUNTIME_MICROVM=1 vitest run src/__tests__/microvm.test.ts"
  },
  "dependencies": {
    "@inhuman.tools/plugin-sdk": "workspace:^",
    "microsandbox": "0.7.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@-internal-/eslint-configs": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": { "node": ">=22" },
  "browserslist": ["node >= 22"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/inhuman-harness.git",
    "directory": "plugins/inhuman-plugin-file-runtime"
  }
}
