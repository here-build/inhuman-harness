{
  "name": "@inhuman.tools/substrate",
  "version": "0.9.0",
  "description": "Doors teaching system for Scheme REPLs: error enrichment, session history replay, futility detection, and optional type hints. Env- and model-agnostic.",
  "homepage": "https://github.com/here-build/inhuman-harness#readme",
  "bugs": {
    "url": "https://github.com/here-build/inhuman-harness/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/here-build/inhuman-harness.git",
    "directory": "packages-runtime/substrate"
  },
  "license": "MIT",
  "author": "Merkle Bonsai",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./doors": {
      "types": "./dist/doors.d.ts",
      "import": "./dist/doors.js"
    },
    "./bound-tool": {
      "types": "./dist/bound-tool.d.ts",
      "import": "./dist/bound-tool.js"
    },
    "./tool-schema": {
      "types": "./dist/tool-schema.d.ts",
      "import": "./dist/tool-schema.js"
    },
    "./unwrap-begin": {
      "types": "./dist/unwrap-begin.d.ts",
      "import": "./dist/unwrap-begin.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!**/__tests__",
    "!**/__research__",
    "!**/__benchmarks__",
    "!**/__custdev__",
    "!**/__visual__",
    "!**/*.test.*",
    "!**/*.stories.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@here.build/arrival": "^0.10.2",
    "@here.build/arrival-serializer": "^0.10.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@-internal-/eslint-configs": "workspace:*",
    "@-internal-/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "9.39.2",
    "typescript": "6.0.2",
    "vitest": "4.1.0"
  },
  "browserslist": [
    "last 2 chrome versions",
    "last 2 firefox versions",
    "last 2 safari versions",
    "ios_saf >= 16.4",
    "node >= 22"
  ]
}
