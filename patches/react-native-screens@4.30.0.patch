+static BOOL RNSStringsEqual(NSString *lhs, NSString *rhs)
+{
+  return lhs == rhs || [lhs isEqualToString:rhs];
+}
+
+// iOS 26 keeps the glass platter and zooms the chevron and title, as one content
+// view, from its center whenever a bar button's title or items are replaced.
+static void RNSPerformWithoutBarButtonZoom(void (^actions)(void))
+{
+#if !TARGET_OS_TV
+  if (@available(iOS 26.0, *)) {
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    [UIView performWithoutAnimation:actions];
+    [CATransaction commit];
+    return;
+  }
+#endif
+  actions();
+}
 
