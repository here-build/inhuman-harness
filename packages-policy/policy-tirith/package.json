{
  "name": "@inhuman.tools/policy-tirith",
  "version": "0.2.0",
  "description": "Host-side Tirith inspection: statement units, the package policy, and the floor map.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "tirith-policy",
    "!**/__tests__"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "tsc -p tsconfig.json --noEmit && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "tirith": "0.4.2",
    "unbash": "4.0.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@-internal-/eslint-configs": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "9.39.2",
    "typescript": "6.0.2",
    "vitest": "4.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/here-build/inhuman-harness.git",
    "directory": "packages-policy/policy-tirith"
  },
  "browserslist": [
    "last 2 chrome versions",
    "last 2 firefox versions",
    "last 2 safari versions",
    "ios_saf >= 16.4",
    "node >= 22"
  ],
  "author": "Merkle Bonsai",
  "publishConfig": {
    "access": "public"
  }
}
