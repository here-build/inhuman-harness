{
  "name": "@inhuman.tools/policy-tirith",
  "version": "0.0.1",
  "private": true,
  "description": "Host-side Tirith inspection: statement units, the package policy, and the floor map.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "tirith-policy", "!**/__tests__"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
